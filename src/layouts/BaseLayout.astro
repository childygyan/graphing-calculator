---
/**
 * BaseLayout — the shared page shell: head metadata, no-FOUC theme script,
 * skip link, header, main slot, footer. Every page extends this layout.
 */
import '../styles/global.css';
import SeoHead from '../components/seo/SeoHead.astro';
import AnalyticsStub from '../components/seo/AnalyticsStub.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { siteConfig } from '../data/site.js';
import { getDictionary, htmlLangFor, type Locale } from '../i18n/index.js';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  noindex?: boolean;
  robots?: string;
  ogImage?: string;
  /** Locale of this page; defaults to English. Drives <html lang>, the skip link, and the header/footer/seo dictionaries. */
  locale?: Locale;
  /** Extra classes for the <main> wrapper (e.g. padding for marketing pages). */
  mainClass?: string;
}

const {
  title,
  description,
  canonicalPath,
  noindex,
  robots,
  ogImage,
  locale = 'en',
  mainClass,
}: Props = Astro.props;
const dict = getDictionary(locale);
---

<!doctype html>
<html lang={htmlLangFor(locale)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SeoHead
      title={title}
      description={description}
      canonicalPath={canonicalPath}
      noindex={noindex}
      robots={robots}
      ogImage={ogImage}
      locale={locale}
    />
    {
      /* Google Analytics (gtag.js) — measurement ID from site config (Firoz, 2026-09-29). */
      siteConfig.googleAnalyticsId && (
        <script
          async
          src={`https://www.googletagmanager.com/gtag/js?id=${siteConfig.googleAnalyticsId}`}
        />
      )
    }
    {siteConfig.googleAnalyticsId && (
      <>
        <script
          async
          src={`https://www.googletagmanager.com/gtag/js?id=${siteConfig.googleAnalyticsId}`}
        />
        <script is:inline define:vars={{ gaId: siteConfig.googleAnalyticsId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() {
            dataLayer.push(arguments);
          }
          gtag('js', new Date());
          gtag('config', gaId);
        </script>
      </>
    )}
    <!--
      Apply the stored theme before first paint to avoid a flash of the
      wrong color scheme. Mirrors the key/defaults in src/data/site.ts;
      the key is inlined as a literal so this script stays dependency-free.
    -->
    <script is:inline>
      (function () {
        try {
          var key = 'graphing-calculator-theme';
          var stored = localStorage.getItem(key) || 'system';
          var dark =
            stored === 'dark' ||
            (stored === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
          document.documentElement.classList.toggle('dark', dark);
          document.documentElement.style.colorScheme = dark ? 'dark' : 'light';
        } catch {
          /* ignore */
        }
      })();
    </script>
  </head>
  <body>
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:m-2 focus:rounded focus:bg-brand-600 focus:px-3 focus:py-2 focus:text-white"
    >
      {dict.chrome.skipLink}
    </a>
    <Header locale={locale} />
    <main id="main-content" class={mainClass}>
      <slot />
    </main>
    <Footer locale={locale} />
    <AnalyticsStub />
  </body>
</html>
