---
/**
 * Breadcrumbs — visible breadcrumb trail plus BreadcrumbList JSON-LD.
 * Every content page (functions, examples, learn, tools) renders one.
 *
 * The landmark's accessible name comes from the chrome dictionary;
 * breadcrumb hrefs are localized (English output unchanged).
 */
import JsonLd from './JsonLd.astro';
import { breadcrumbSchema, type BreadcrumbItem } from '../../lib/seo/metadata';
import { getDictionary, localizePath, type Locale } from '../../i18n/index.js';

interface Props {
  items: BreadcrumbItem[];
  locale?: Locale;
}

const { items, locale = 'en' }: Props = Astro.props;
const dict = getDictionary(locale);
const localized = items.map((item) => ({
  ...item,
  href: item.href ? localizePath(item.href, locale) : item.href,
}));
---

<nav aria-label={dict.chrome.breadcrumbs.ariaLabel} class="mb-6 text-sm">
  <ol class="flex flex-wrap items-center gap-1 text-slate-500 dark:text-slate-400">
    {localized.map((item, index) => (
      <li class="flex items-center gap-1">
        {index > 0 && (
          <span aria-hidden="true" class="text-slate-300 dark:text-slate-600">
            /
          </span>
        )}
        {item.href ? (
          <a
            href={item.href}
            class="rounded hover:text-brand-700 hover:underline dark:hover:text-brand-300"
          >
            {item.label}
          </a>
        ) : (
          <span aria-current="page" class="font-medium text-slate-700 dark:text-slate-200">
            {item.label}
          </span>
        )}
      </li>
    ))}
  </ol>
</nav>
<JsonLd schemas={[breadcrumbSchema(localized)]} />
