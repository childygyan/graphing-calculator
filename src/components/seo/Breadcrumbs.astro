---
/**
 * Breadcrumbs — visible breadcrumb trail plus BreadcrumbList JSON-LD.
 * Every content page (functions, examples, learn, tools) renders one.
 */
import JsonLd from './JsonLd.astro';
import { breadcrumbSchema, type BreadcrumbItem } from '../../lib/seo/metadata';

interface Props {
  items: BreadcrumbItem[];
}

const { items }: Props = Astro.props;
---

<nav aria-label="Breadcrumb" class="mb-6 text-sm">
  <ol class="flex flex-wrap items-center gap-1 text-slate-500 dark:text-slate-400">
    {items.map((item, index) => (
      <li class="flex items-center gap-1">
        {index > 0 && (
          <span aria-hidden="true" class="text-slate-300 dark:text-slate-600">
            /
          </span>
        )}
        {item.href ? (
          <a
            href={item.href}
            class="rounded hover:text-brand-700 hover:underline dark:hover:text-brand-300"
          >
            {item.label}
          </a>
        ) : (
          <span aria-current="page" class="font-medium text-slate-700 dark:text-slate-200">
            {item.label}
          </span>
        )}
      </li>
    ))}
  </ol>
</nav>
<JsonLd schemas={[breadcrumbSchema(items)]} />
