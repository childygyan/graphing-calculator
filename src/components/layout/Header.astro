---
/**
 * Header — sticky site header: logo, desktop primary nav, theme toggle,
 * language switcher, and a CSS-only mobile menu (<details>/<summary>,
 * no JavaScript needed).
 *
 * Nav labels come from the chrome dictionary; hrefs are localized, and the
 * active state compares the locale-stripped current path against the
 * canonical English hrefs, so English output is unchanged.
 */
import Logo from './Logo.astro';
import ThemeToggle from '../ui/ThemeToggle.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { MenuIcon } from '../ui/icons.tsx';
import { getDictionary, localizePath, stripLocale, type Locale } from '../../i18n/index.js';

interface Props {
  locale?: Locale;
}

const { locale = 'en' }: Props = Astro.props;
const dict = getDictionary(locale);
const nav = dict.chrome.nav;
const currentPath = stripLocale(Astro.url.pathname);
const isCurrent = (href: string) => currentPath === href;

const linkClass = (current: boolean) =>
  current
    ? 'rounded-md px-3 py-2 text-sm font-medium text-brand-700 dark:text-brand-300'
    : 'rounded-md px-3 py-2 text-sm font-medium text-slate-600 hover:bg-slate-100 hover:text-slate-900 dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-white';
---

<header class="sticky top-0 z-40 border-b border-slate-200 bg-white/80 backdrop-blur dark:border-slate-800 dark:bg-slate-950/80">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-4 px-4 sm:px-6">
    <Logo label={dict.chrome.logoAriaLabel} />

    <nav aria-label={nav.primaryLabel} class="hidden md:flex md:items-center md:gap-1">
      {nav.items.map((link) => (
        <a
          href={localizePath(link.href, locale)}
          class={linkClass(isCurrent(link.href))}
          aria-current={isCurrent(link.href) ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <ThemeToggle />
      <LanguageSwitcher locale={locale} />

      <details class="relative md:hidden [&>summary]:list-none [&>summary::-webkit-details-marker]:hidden">
        <summary
          aria-label={nav.openMenu}
          class="cursor-pointer rounded-md p-2 text-slate-700 hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-slate-800"
        >
          <MenuIcon className="h-5 w-5" />
        </summary>
        <nav
          aria-label={nav.mobileLabel}
          class="absolute right-0 top-full z-50 mt-2 w-56 rounded-lg border border-slate-200 bg-white p-2 shadow-lg dark:border-slate-700 dark:bg-slate-900"
        >
          {nav.items.map((link) => (
            <a
              href={localizePath(link.href, locale)}
              class={`block ${linkClass(isCurrent(link.href))}`}
              aria-current={isCurrent(link.href) ? 'page' : undefined}
            >
              {link.label}
            </a>
          ))}
        </nav>
      </details>
    </div>
  </div>
</header>
