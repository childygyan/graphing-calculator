---
/**
 * About (it): mirrors the English page. Strings from the locale
 * dictionary; creator photo, URLs, and name stay as-is.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import RelatedLinks from '../../../components/content/RelatedLinks.astro';
import { getDictionary, type Locale } from '../../../i18n/index.js';

const locale: Locale = 'it';
const dict = getDictionary(locale);
const ns = dict.about;
---

<BaseLayout
  title={ns.seo.title}
  description={ns.seo.description}
  canonicalPath="/it/about/"
  locale={locale}
  mainClass="mx-auto w-full max-w-3xl px-4 py-10 sm:py-14"
>
  <h1 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-white">{ns.heading}</h1>

  <div class="mt-6 space-y-4 text-slate-600 dark:text-slate-300">
    {ns.intro.map((paragraph) => (
      <p>{paragraph}</p>
    ))}

    <h2 class="pt-2 text-xl font-semibold text-slate-900 dark:text-white">{ns.creator.heading}</h2>
    <div class="flex flex-col items-start gap-5 sm:flex-row sm:items-center">
      <img
        src="/images/firoz-khan.webp"
        alt={ns.creator.imageAlt}
        width="160"
        height="160"
        loading="lazy"
        class="h-32 w-32 shrink-0 rounded-full object-cover ring-1 ring-slate-200 dark:ring-slate-700"
      />
      <div>
        <p class="font-semibold text-slate-900 dark:text-white">{ns.creator.name}</p>
        <p class="mt-1">{ns.creator.body}</p>
        <ul class="mt-3 flex flex-wrap gap-3">
          {ns.creator.links.map((link) => (
            <li>
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                class="text-brand-700 hover:underline dark:text-brand-300"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    {ns.sections.map((section) => (
      <>
        <h2 class="pt-2 text-xl font-semibold text-slate-900 dark:text-white">{section.heading}</h2>
        {section.body.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </>
    ))}
  </div>

  <RelatedLinks paths={ns.related} locale={locale} />
</BaseLayout>
