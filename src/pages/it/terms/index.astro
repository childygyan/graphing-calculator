---
/**
 * Terms of Service (it): the legal body stays in English verbatim (translating
 * legal text changes legal meaning). Only the chrome is localized: title and
 * description from the locale dictionary, and the "last updated" line uses
 * the dictionary's updatedTemplate.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getDictionary, format, type Locale } from '../../../i18n/index.js';

const locale: Locale = 'it';
const dict = getDictionary(locale);
const ns = dict.legal.terms;

// The date itself is never translated; only the surrounding template is.
const updatedLine = format(ns.updatedTemplate, { date: 'September 29, 2026' });
---

<BaseLayout
  title={ns.seo.title}
  description={ns.seo.description}
  canonicalPath="/it/terms/"
  locale={locale}
  mainClass="mx-auto w-full max-w-3xl px-4 py-10 sm:py-14"
>
  <h1 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-white">Terms of Service</h1>
  <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">{updatedLine}</p>

  <div class="mt-6 space-y-4 text-slate-600 dark:text-slate-300">
    <aside
      class="rounded-lg border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-600 dark:border-slate-700 dark:bg-slate-800/50 dark:text-slate-300"
      aria-label={dict.legal.notice.title}
    >
      <p>
        <strong class="font-semibold text-slate-900 dark:text-white">
          {dict.legal.notice.title}
        </strong>{' '}
        {dict.legal.notice.body}
      </p>
    </aside>
    <h2 class="pt-2 text-xl font-semibold text-slate-900 dark:text-white">The service</h2>
    <p>
      The Graphing Calculator is provided as-is, for education and exploration. While we aim for
      correctness, we make no guarantees about the accuracy of any output, and the tool is not
      professional mathematical, engineering, or financial advice.
    </p>
    <h2 class="pt-2 text-xl font-semibold text-slate-900 dark:text-white">Acceptable use</h2>
    <p>
      Use the calculator for lawful purposes only. Do not attempt to disrupt the service, probe it
      for vulnerabilities, or use it in a way that harms others.
    </p>
    <h2 class="pt-2 text-xl font-semibold text-slate-900 dark:text-white">Changes</h2>
    <p>
      These terms may be updated as the product evolves; the last-updated date above reflects the
      current version. Continued use of the site after changes constitutes acceptance of the updated
      terms.
    </p>
  </div>
</BaseLayout>
