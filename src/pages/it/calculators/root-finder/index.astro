---
/**
 * Root finder tool page (it): mirrors the English page. Strings from the locale dictionary.
 */
import ToolPageShell from '../../../../components/content/ToolPageShell.astro';
import { RootFinderTool } from '../../../../components/tools/MathTools.js';
import { getDictionary, type Locale } from '../../../../i18n/index.js';

const locale: Locale = 'it';
const dict = getDictionary(locale);
const ns = dict.calculators.rootFinder;

// FaqBlock consumes ContentFaq ({q, a}); the dictionary uses {question, answer}.
const faqs = ns.faqs.map((faq) => ({ q: faq.question, a: faq.answer }));
---

<ToolPageShell
  title={ns.seo.title}
  description={ns.seo.description}
  canonicalPath="/it/calculators/root-finder/"
  breadcrumbs={ns.crumbs}
  heading={ns.heading}
  intro={ns.intro}
  sections={ns.sections}
  faqs={faqs}
  related={ns.related}
  locale={locale}
>
  <RootFinderTool client:load slot="tool" strings={ns.tool} />
</ToolPageShell>
