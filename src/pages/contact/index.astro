---
/**
 * Contact — static page. Email link only; no form, because there is no
 * backend in Phase 1 and a form that goes nowhere would be dishonest.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteConfig } from '../../data/site.js';
---

<BaseLayout
  title="Contact"
  description="How to get in touch about the AI Graphing Calculator."
  canonicalPath="/contact/"
  mainClass="mx-auto w-full max-w-3xl px-4 py-10 sm:py-14"
>
  <h1 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-white">Contact</h1>
  <div class="mt-6 space-y-4 text-slate-600 dark:text-slate-300">
    <p>
      Questions, bug reports, or feedback about the calculator are welcome. The best way to reach us
      is email:
    </p>
    <p>
      <a
        href={`mailto:${siteConfig.contactEmail}`}
        class="font-medium text-brand-600 hover:underline dark:text-brand-400"
      >
        {siteConfig.contactEmail}
      </a>
    </p>
    <p class="text-sm">
      There is no contact form on this page — the project has no backend yet, and a form that
      submitted to nowhere would be dishonest. Email reaches a real inbox.
    </p>
  </div>
</BaseLayout>
