---
/**
 * Curated example graphs (fr): mirrors the English template. Strings
 * from the locale dictionary and locale content data (same slugs; expression
 * syntax is never translated). The "Open in calculator" link carries the
 * same precomputed share payload as the English page.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/seo/Breadcrumbs.astro';
import ArticleSections from '../../../components/content/ArticleSections.astro';
import RelatedLinks from '../../../components/content/RelatedLinks.astro';
import { getDictionary, type Locale } from '../../../i18n/index.js';
import { EXAMPLE_GRAPHS } from '../../../data/seo/fr/examples.js';
import { buildExampleShareUrl } from '../../../lib/seo/content-engine.js';

const locale: Locale = 'fr';
const dict = getDictionary(locale);
const ns = dict.examples;

export function getStaticPaths() {
  return EXAMPLE_GRAPHS.map((example) => ({ params: { slug: example.slug }, props: { example } }));
}

const { example } = Astro.props;
const shareUrl = await buildExampleShareUrl(example);
const canonicalPath = `/fr/examples/${example.slug}/`;
// NOTE: no dictionary title template exists for example pages; the English
// page title pattern is kept verbatim (only the title localizes).
const title = `${example.title} | Graphing Calculator`;

const expressionLabels = example.expressions.map((spec) => {
  switch (spec.kind) {
    case 'parametric':
      return `x = ${spec.xOfT ?? 't'}, y = ${spec.yOfT ?? 't'}`;
    case 'polar':
      return `r = ${spec.rOfTheta ?? '1'}`;
    case 'inequality':
      return `${spec.inequality?.lhs ?? 'y'} ${spec.inequality?.operator ?? '<'} ${spec.inequality?.rhs ?? 'x'}`;
    default:
      return `y = ${spec.rhs ?? 'x'}`;
  }
});
---

<BaseLayout
  title={title}
  description={example.description}
  canonicalPath={canonicalPath}
  locale={locale}
>
  <div class="mx-auto max-w-4xl px-4 py-10 sm:px-6">
    <Breadcrumbs
      items={[{ ...ns.crumbs[0] }, { ...ns.crumbs[1] }, { label: example.title }]}
      locale={locale}
    />

    <p class="text-sm font-semibold uppercase tracking-wide text-brand-600 dark:text-brand-400">
      {ns.template.eyebrow}
    </p>
    <h1 class="mt-2 text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white">
      {example.title}
    </h1>

    {example.story.map((paragraph) => (
      <p class="mt-6 leading-7 text-slate-600 dark:text-slate-300">{paragraph}</p>
    ))}

    <section
      class="mt-10 rounded-xl border border-slate-200 bg-slate-50 p-6 dark:border-slate-700 dark:bg-slate-800/50"
      aria-labelledby="plotted-expressions"
    >
      <h2
        id="plotted-expressions"
        class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white"
      >
        {ns.template.plottedHeading}
      </h2>
      <ul class="mt-4 space-y-2 font-mono text-slate-900 dark:text-white">
        {expressionLabels.map((label) => (
          <li class="rounded bg-white px-3 py-2 dark:bg-slate-900">{label}</li>
        ))}
      </ul>
      <a
        href={shareUrl}
        class="mt-6 inline-block rounded-md bg-brand-600 px-6 py-3 font-medium text-white hover:bg-brand-700"
      >
        {ns.template.openCta}
      </a>
      <p class="mt-3 text-sm text-slate-500 dark:text-slate-400">{ns.template.preloadNote}</p>
    </section>

    <section class="mt-10">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white">
        {ns.template.noticeHeading}
      </h2>
      <ul class="mt-4 list-disc space-y-2 pl-6 text-slate-600 dark:text-slate-300">
        {example.insights.map((insight) => (
          <li class="leading-7">{insight}</li>
        ))}
      </ul>
    </section>

    <RelatedLinks paths={example.related} locale={locale} />
  </div>
</BaseLayout>
