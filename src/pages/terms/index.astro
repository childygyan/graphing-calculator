---
/**
 * Terms of Service — static page. Concise terms matching the product:
 * an educational tool, provided as-is, with basic acceptable use.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Terms of Service"
  description="Terms of service for the Graphing Calculator: usage rules and disclaimers."
  canonicalPath="/terms/"
  mainClass="mx-auto w-full max-w-3xl px-4 py-10 sm:py-14"
>
  <h1 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-white">Terms of Service</h1>
  <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">Last updated: September 29, 2026</p>

  <div class="mt-6 space-y-4 text-slate-600 dark:text-slate-300">
    <h2 class="pt-2 text-xl font-semibold text-slate-900 dark:text-white">The service</h2>
    <p>
      The Graphing Calculator is provided as-is, for education and exploration. While we aim for
      correctness, we make no guarantees about the accuracy of any output, and the tool is not
      professional mathematical, engineering, or financial advice.
    </p>
    <h2 class="pt-2 text-xl font-semibold text-slate-900 dark:text-white">Acceptable use</h2>
    <p>
      Use the calculator for lawful purposes only. Do not attempt to disrupt the service, probe it
      for vulnerabilities, or use it in a way that harms others.
    </p>
    <h2 class="pt-2 text-xl font-semibold text-slate-900 dark:text-white">Changes</h2>
    <p>
      These terms may be updated as the product evolves; the last-updated date above reflects the
      current version. Continued use of the site after changes constitutes acceptance of the updated
      terms.
    </p>
  </div>
</BaseLayout>
