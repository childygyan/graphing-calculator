---
/**
 * Learn hub: educational articles about graphing concepts.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import RelatedLinks from '../../components/content/RelatedLinks.astro';
import { LEARN_ARTICLES } from '../../data/seo/learn.js';

const title = 'Learn Graphing — Functions, Derivatives, Integrals & More | AI Graphing Calculator';
const description =
  'Learn graphing concepts step by step: functions, derivatives, integrals, asymptotes, inequalities, and parametric equations — with examples to try.';
---

<BaseLayout title={title} description={description} canonicalPath="/learn/">
  <div class="mx-auto max-w-4xl px-4 py-10 sm:px-6">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Learn' }]} />
    <h1 class="text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white">
      Learn Graphing
    </h1>
    <p class="mt-4 text-xl leading-8 text-slate-600 dark:text-slate-300">
      Short, practical guides to the ideas behind the graphs — written to be read alongside the
      calculator, with expressions you can try yourself.
    </p>

    <div class="mt-10 space-y-4">
      {LEARN_ARTICLES.map((article) => (
        <a
          href={`/learn/${article.slug}/`}
          class="group block rounded-xl border border-slate-200 bg-white p-6 shadow-sm transition hover:border-brand-300 hover:shadow dark:border-slate-700 dark:bg-slate-900"
        >
          <h2 class="text-xl font-bold text-slate-900 group-hover:text-brand-700 dark:text-white dark:group-hover:text-brand-300">
            {article.title}
          </h2>
          <p class="mt-2 text-slate-600 dark:text-slate-300">{article.description}</p>
        </a>
      ))}
    </div>

    <RelatedLinks
      paths={['/graphing-calculator/', '/math-functions/', '/examples/', '/calculators/']}
    />
  </div>
</BaseLayout>
