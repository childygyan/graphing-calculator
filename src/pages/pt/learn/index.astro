---
/**
 * Learn hub (pt): mirrors the English page. Strings from the locale
 * dictionary; article cards from the locale content data (same slugs).
 * Review dates render with the dictionary's short month names.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/seo/Breadcrumbs.astro';
import RelatedLinks from '../../../components/content/RelatedLinks.astro';
import { getDictionary, localizePath, format, type Locale } from '../../../i18n/index.js';
import { LEARN_ARTICLES } from '../../../data/seo/pt/learn.js';

const locale: Locale = 'pt';
const dict = getDictionary(locale);
const ns = dict.learn;

/** Compact localized short-date form; null when the article carries no valid date. */
function shortReviewDate(iso: string | undefined): string | null {
  if (!iso || !/^\d{4}-\d{2}-\d{2}$/.test(iso)) return null;
  const [year, month, day] = iso.split('-').map(Number);
  const months = ns.shortMonths;
  if (month < 1 || month > 12 || day < 1 || day > 31) return null;
  return `${months[month - 1]} ${day}, ${year}`;
}
---

<BaseLayout
  title={ns.seo.title}
  description={ns.seo.description}
  canonicalPath="/pt/learn/"
  locale={locale}
>
  <div class="mx-auto max-w-4xl px-4 py-10 sm:px-6">
    <Breadcrumbs items={ns.crumbs} locale={locale} />
    <h1 class="text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white">
      {ns.heading}
    </h1>
    <p class="mt-4 text-xl leading-8 text-slate-600 dark:text-slate-300">{ns.intro}</p>

    <div class="mt-10 space-y-4">
      {LEARN_ARTICLES.map((article) => {
        const review = shortReviewDate(article.reviewedOn);
        return (
          <a
            href={localizePath(`/learn/${article.slug}/`, locale)}
            class="group block rounded-xl border border-slate-200 bg-white p-6 shadow-sm transition hover:border-brand-300 hover:shadow dark:border-slate-700 dark:bg-slate-900"
          >
            <h2 class="text-xl font-bold text-slate-900 group-hover:text-brand-700 dark:text-white dark:group-hover:text-brand-300">
              {article.title}
            </h2>
            <p class="mt-2 text-slate-600 dark:text-slate-300">{article.description}</p>
            {review && (
              <p class="mt-3 text-xs text-slate-500 dark:text-slate-400">
                {format(ns.template.indexCardReviewTemplate, { date: review })}
              </p>
            )}
          </a>
        );
      })}
    </div>

    <RelatedLinks paths={ns.related} locale={locale} />
  </div>
</BaseLayout>
