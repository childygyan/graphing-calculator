---
/**
 * Contact (es): mirrors the English page. Email link only; no form.
 * The email address is a site-config value and is never translated.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getDictionary, type Locale } from '../../../i18n/index.js';
import { siteConfig } from '../../../data/site.js';

const locale: Locale = 'es';
const dict = getDictionary(locale);
const ns = dict.contact;
---

<BaseLayout
  title={ns.seo.title}
  description={ns.seo.description}
  canonicalPath="/es/contact/"
  locale={locale}
  mainClass="mx-auto w-full max-w-3xl px-4 py-10 sm:py-14"
>
  <h1 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-white">{ns.heading}</h1>
  <div class="mt-6 space-y-4 text-slate-600 dark:text-slate-300">
    {ns.body.map((paragraph) => (
      <p>{paragraph}</p>
    ))}
    <p>
      <a
        href={`mailto:${siteConfig.contactEmail}`}
        class="font-medium text-brand-600 hover:underline dark:text-brand-400"
      >
        {siteConfig.contactEmail}
      </a>
    </p>
    <p class="text-sm">{ns.emailNote}</p>
  </div>
</BaseLayout>
