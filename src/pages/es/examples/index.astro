---
/**
 * Graph examples hub (es): mirrors the English page. Strings from the
 * locale dictionary; cards from the locale content data (same slugs).
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/seo/Breadcrumbs.astro';
import RelatedLinks from '../../../components/content/RelatedLinks.astro';
import { getDictionary, localizePath, type Locale } from '../../../i18n/index.js';
import { EXAMPLE_GRAPHS } from '../../../data/seo/es/examples.js';

const locale: Locale = 'es';
const dict = getDictionary(locale);
const ns = dict.examples;
---

<BaseLayout
  title={ns.seo.title}
  description={ns.seo.description}
  canonicalPath="/es/examples/"
  locale={locale}
>
  <div class="mx-auto max-w-4xl px-4 py-10 sm:px-6">
    <Breadcrumbs items={ns.crumbs} locale={locale} />
    <h1 class="text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white">
      {ns.heading}
    </h1>
    <p class="mt-4 text-xl leading-8 text-slate-600 dark:text-slate-300">{ns.intro}</p>

    <div class="mt-10 grid gap-4 sm:grid-cols-2">
      {EXAMPLE_GRAPHS.map((example) => (
        <a
          href={localizePath(`/examples/${example.slug}/`, locale)}
          class="group rounded-xl border border-slate-200 bg-white p-6 shadow-sm transition hover:border-brand-300 hover:shadow dark:border-slate-700 dark:bg-slate-900"
        >
          <h2 class="text-xl font-bold text-slate-900 group-hover:text-brand-700 dark:text-white dark:group-hover:text-brand-300">
            {example.title}
          </h2>
          <p class="mt-2 line-clamp-3 text-slate-600 dark:text-slate-300">{example.description}</p>
        </a>
      ))}
    </div>

    <RelatedLinks paths={ns.related} locale={locale} />
  </div>
</BaseLayout>
