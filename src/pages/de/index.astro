---
/**
 * Homepage (de): mirrors the English homepage. Strings from the locale
 * dictionary; internal links are localized.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  Card,
  CardHeader,
  CardTitle,
  CardDescription,
  CardContent,
  CardFooter,
} from '../../components/ui/index.js';
import { ArrowRightIcon } from '../../components/ui/icons.js';
import { CalculatorPage } from '../../components/calculator/CalculatorPage.js';
import { getDictionary, localizePath, type Locale } from '../../i18n/index.js';

const locale: Locale = 'de';
const dict = getDictionary(locale);
const ns = dict.home;
---

<BaseLayout
  title={ns.seo.title}
  description={ns.seo.description}
  canonicalPath="/de/"
  locale={locale}
  mainClass="flex flex-col"
>
  <section class="mx-auto w-full max-w-5xl px-4 pt-8 text-center sm:pt-10">
    <h1 class="text-4xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-5xl">
      {ns.hero.title}
    </h1>
    <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-600 dark:text-slate-300">
      {ns.hero.subtitle}
    </p>
  </section>

  <CalculatorPage client:load strings={dict.calculator.shell} />

  <div class="mx-auto w-full max-w-5xl px-4 py-10 sm:py-14">
  <section aria-label={ns.tutorial.ariaLabel}>
    <h2 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-white">
      {ns.tutorial.heading}
    </h2>
    <p class="mt-4 max-w-2xl text-lg text-slate-600 dark:text-slate-300">
      {ns.tutorial.lede}
    </p>
    <ol class="mt-10 space-y-12">
      {ns.tutorial.steps.map((step, i) => (
        <li>
          <div class="flex items-start gap-4">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-brand-600 text-base font-bold text-white dark:bg-brand-500">{i + 1}</span>
            <div>
              <h3 class="text-xl font-bold text-slate-900 dark:text-white">{step.title}</h3>
              <p class="mt-2 text-slate-600 dark:text-slate-300">{step.body}</p>
            </div>
          </div>
          <img
            src={step.image}
            alt={step.alt}
            width="1280"
            height="720"
            loading="lazy"
            class="mt-4 rounded-xl border border-slate-200 shadow-sm dark:border-slate-700"
          />
        </li>
      ))}
    </ol>
  </section>

  <section aria-label={ns.features.ariaLabel} class="mt-14">
    <div class="grid gap-4 sm:grid-cols-2">
      {ns.features.cards.map((card) => (
        <Card className="flex flex-col">
          <CardHeader>
            <CardTitle>{card.title}</CardTitle>
            <CardDescription>{card.description}</CardDescription>
          </CardHeader>
          <CardContent className="flex-1">
            <p class="text-sm text-slate-600 dark:text-slate-300">{card.body}</p>
          </CardContent>
          <CardFooter>
            <a
              href={localizePath(card.href, locale)}
              class="inline-flex items-center gap-1 text-sm font-medium text-brand-600 hover:underline dark:text-brand-400"
            >
              {card.cta} <ArrowRightIcon className="h-4 w-4" />
            </a>
          </CardFooter>
        </Card>
      ))}
    </div>
  </section>

  <section aria-label={ns.explore.ariaLabel} class="mt-14">
    <h2 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white">
      {ns.explore.heading}
    </h2>
    <div class="mt-6 grid gap-4 sm:grid-cols-3">
      {ns.explore.cards.map((card) => (
        <a
          href={localizePath(card.href, locale)}
          class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm transition hover:border-brand-300 hover:shadow dark:border-slate-700 dark:bg-slate-900"
        >
          <h3 class="text-lg font-bold text-slate-900 dark:text-white">{card.title}</h3>
          <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">{card.body}</p>
        </a>
      ))}
    </div>
  </section>
  </div>
</BaseLayout>
