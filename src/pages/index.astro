---
/**
 * Homepage — static marketing page. No client directives: the Card
 * components render to plain HTML with zero JavaScript.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../data/site.js';
import {
  Card,
  CardHeader,
  CardTitle,
  CardDescription,
  CardContent,
  CardFooter,
} from '../components/ui/index.js';
import { ArrowRightIcon } from '../components/ui/icons.js';
---

<BaseLayout
  title="AI Graphing Calculator — Graph Functions Online"
  description={siteConfig.description}
  canonicalPath="/"
  mainClass="mx-auto w-full max-w-5xl px-4 py-10 sm:py-16"
>
  <section class="text-center">
    <h1 class="text-4xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-5xl">
      AI Graphing Calculator
    </h1>
    <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-600 dark:text-slate-300">
      Graph mathematical functions in your browser — fast, accessible, and free. AI-assisted math
      exploration is on the roadmap.
    </p>
    <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
      <a
        href="/graphing-calculator/"
        class="inline-flex items-center justify-center gap-2 rounded-lg bg-brand-600 px-6 py-3 text-base font-medium text-white shadow-sm hover:bg-brand-700 dark:bg-brand-500 dark:hover:bg-brand-400"
      >
        Open Graphing Calculator
      </a>
      <a
        href="/calculators/"
        class="inline-flex items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-6 py-3 text-base font-medium text-slate-700 hover:bg-slate-50 hover:text-slate-900 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800 dark:hover:text-white"
      >
        Explore Calculators
      </a>
    </div>
  </section>

  <section aria-label="Features" class="mt-14">
    <div class="grid gap-4 sm:grid-cols-2">
      <Card className="flex flex-col">
        <CardHeader>
          <CardTitle>Interactive graphing</CardTitle>
          <CardDescription>In active development</CardDescription>
        </CardHeader>
        <CardContent className="flex-1">
          <p class="text-sm text-slate-600 dark:text-slate-300">
            The 2D graph renderer lands next. Today&rsquo;s foundation is real: an expression panel
            plus viewport state that zoom and reset act on.
          </p>
        </CardContent>
        <CardFooter>
          <a
            href="/graphing-calculator/"
            class="inline-flex items-center gap-1 text-sm font-medium text-brand-600 hover:underline dark:text-brand-400"
          >
            Open the calculator <ArrowRightIcon className="h-4 w-4" />
          </a>
        </CardFooter>
      </Card>

      <Card className="flex flex-col">
        <CardHeader>
          <CardTitle>Expression-first</CardTitle>
          <CardDescription>Available now</CardDescription>
        </CardHeader>
        <CardContent className="flex-1">
          <p class="text-sm text-slate-600 dark:text-slate-300">
            Manage multiple expressions, each with its own color and visibility toggle. Your
            workspace persists in your browser between visits.
          </p>
        </CardContent>
        <CardFooter>
          <a
            href="/graphing-calculator/"
            class="inline-flex items-center gap-1 text-sm font-medium text-brand-600 hover:underline dark:text-brand-400"
          >
            Try it out <ArrowRightIcon className="h-4 w-4" />
          </a>
        </CardFooter>
      </Card>

      <Card className="flex flex-col">
        <CardHeader>
          <CardTitle>AI assistance</CardTitle>
          <CardDescription>Planned</CardDescription>
        </CardHeader>
        <CardContent className="flex-1">
          <p class="text-sm text-slate-600 dark:text-slate-300">
            On the roadmap: natural-language math commands and step-by-step explanations, powered by
            a real provider — never by the calculator itself.
          </p>
        </CardContent>
        <CardFooter>
          <a
            href="/about/"
            class="inline-flex items-center gap-1 text-sm font-medium text-brand-600 hover:underline dark:text-brand-400"
          >
            See the roadmap <ArrowRightIcon className="h-4 w-4" />
          </a>
        </CardFooter>
      </Card>

      <Card className="flex flex-col">
        <CardHeader>
          <CardTitle>More calculators</CardTitle>
          <CardDescription>Planned</CardDescription>
        </CardHeader>
        <CardContent className="flex-1">
          <p class="text-sm text-slate-600 dark:text-slate-300">
            A small collection of focused math tools is planned. The graphing calculator is the
            first; the rest will arrive as they are genuinely ready.
          </p>
        </CardContent>
        <CardFooter>
          <a
            href="/calculators/"
            class="inline-flex items-center gap-1 text-sm font-medium text-brand-600 hover:underline dark:text-brand-400"
          >
            Browse the collection <ArrowRightIcon className="h-4 w-4" />
          </a>
        </CardFooter>
      </Card>
    </div>
  </section>
</BaseLayout>
