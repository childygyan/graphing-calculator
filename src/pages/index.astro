---
/**
 * Homepage — the main graphing calculator lives here, directly on the
 * home page (same CalculatorPage island as /graphing-calculator/).
 * A step-by-step tutorial with genuine calculator screenshots, plus the
 * marketing sections (features, explore), sit below the calculator.
 *
 * Copy describes only shipped functionality: interactive graphing,
 * expression engine, analysis tools, sliders/parametric/polar,
 * AI assistant, and save/share.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { CalculatorPage } from '../components/calculator/CalculatorPage.js';
import { getDictionary } from '../i18n/index.js';

const dict = getDictionary('en');
import {
  Card,
  CardHeader,
  CardTitle,
  CardDescription,
  CardContent,
  CardFooter,
} from '../components/ui/index.js';
import { ArrowRightIcon } from '../components/ui/icons.js';
---

<BaseLayout
  title="Graphing Calculator — Graph Functions Online Free"
  description="Free online graphing calculator: plot functions, analyze roots, derivatives and integrals, explore with sliders, and get AI math help. No sign-up needed."
  canonicalPath="/"
  mainClass="flex flex-col"
>
  <section class="mx-auto w-full max-w-5xl px-4 pt-8 text-center sm:pt-10">
    <h1 class="text-4xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-5xl">
      Graphing Calculator
    </h1>
    <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-600 dark:text-slate-300">
      Graph mathematical functions in your browser — fast, accessible, and free. No sign-up, no
      download.
    </p>
  </section>

  <CalculatorPage client:load strings={dict.calculator.shell} />

  <div class="mx-auto w-full max-w-5xl px-4 py-10 sm:py-14">
  <section aria-label="Tutorial">
    <h2 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-white">
      How to use the graphing calculator
    </h2>
    <p class="mt-4 max-w-2xl text-lg text-slate-600 dark:text-slate-300">
      Five steps, using the calculator above. Every screenshot below is a real render from this
      calculator — no mockups.
    </p>
    <ol class="mt-10 space-y-12">
      <li>
        <div class="flex items-start gap-4">
          <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-brand-600 text-base font-bold text-white dark:bg-brand-500">1</span>
          <div>
            <h3 class="text-xl font-bold text-slate-900 dark:text-white">Type your first expression</h3>
            <p class="mt-2 text-slate-600 dark:text-slate-300">
              Click in the Expressions panel and type <code>x^2</code>. The parabola plots instantly
              as you type — there is nothing to install and no account to create.
            </p>
          </div>
        </div>
        <img
          src="/images/tutorial/step-1-first-expression.png"
          alt="Graphing calculator showing the parabola y = x squared"
          width="1280"
          height="720"
          loading="lazy"
          class="mt-4 rounded-xl border border-slate-200 shadow-sm dark:border-slate-700"
        />
      </li>
      <li>
        <div class="flex items-start gap-4">
          <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-brand-600 text-base font-bold text-white dark:bg-brand-500">2</span>
          <div>
            <h3 class="text-xl font-bold text-slate-900 dark:text-white">Compare two curves</h3>
            <p class="mt-2 text-slate-600 dark:text-slate-300">
              Click Add and type <code>sin(x)</code>. Each expression gets its own color, and the
              eye icon toggles each curve on or off, so you can compare shapes side by side.
            </p>
          </div>
        </div>
        <img
          src="/images/tutorial/step-2-compare-curves.png"
          alt="Graphing calculator comparing the parabola y = x squared with a sine wave"
          width="1280"
          height="720"
          loading="lazy"
          class="mt-4 rounded-xl border border-slate-200 shadow-sm dark:border-slate-700"
        />
      </li>
      <li>
        <div class="flex items-start gap-4">
          <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-brand-600 text-base font-bold text-white dark:bg-brand-500">3</span>
          <div>
            <h3 class="text-xl font-bold text-slate-900 dark:text-white">Zoom and pan around the graph</h3>
            <p class="mt-2 text-slate-600 dark:text-slate-300">
              Scroll to zoom toward your cursor and drag to pan. Zooming into the vertex of
              <code>x^2</code> shows the curve flattening out at (0, 0).
            </p>
          </div>
        </div>
        <img
          src="/images/tutorial/step-3-zoom-in.png"
          alt="Zoomed-in view of the parabola y = x squared around its vertex at (0, 0)"
          width="1280"
          height="720"
          loading="lazy"
          class="mt-4 rounded-xl border border-slate-200 shadow-sm dark:border-slate-700"
        />
      </li>
      <li>
        <div class="flex items-start gap-4">
          <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-brand-600 text-base font-bold text-white dark:bg-brand-500">4</span>
          <div>
            <h3 class="text-xl font-bold text-slate-900 dark:text-white">Find where a curve crosses the x-axis</h3>
            <p class="mt-2 text-slate-600 dark:text-slate-300">
              For <code>x^2 - 4</code>, the roots show up as markers right on the graph — at
              x = -2 and x = 2. The Analysis panel can find roots, derivatives, integrals, and
              more for any expression.
            </p>
          </div>
        </div>
        <img
          src="/images/tutorial/step-4-roots.png"
          alt="Graph of y = x squared minus 4 with root markers at x = -2 and x = 2"
          width="1280"
          height="720"
          loading="lazy"
          class="mt-4 rounded-xl border border-slate-200 shadow-sm dark:border-slate-700"
        />
      </li>
      <li>
        <div class="flex items-start gap-4">
          <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-brand-600 text-base font-bold text-white dark:bg-brand-500">5</span>
          <div>
            <h3 class="text-xl font-bold text-slate-900 dark:text-white">Draw a tangent line</h3>
            <p class="mt-2 text-slate-600 dark:text-slate-300">
              Pick a point on a curve — here x = 1 on <code>x^2</code> — and the tangent line
              appears at (1, 1), with its slope computed by the math engine.
            </p>
          </div>
        </div>
        <img
          src="/images/tutorial/step-5-tangent.png"
          alt="Graph of y = x squared with a tangent line at x = 1"
          width="1280"
          height="720"
          loading="lazy"
          class="mt-4 rounded-xl border border-slate-200 shadow-sm dark:border-slate-700"
        />
      </li>
    </ol>
  </section>

  <section aria-label="Features" class="mt-14">
    <div class="grid gap-4 sm:grid-cols-2">
      <Card className="flex flex-col">
        <CardHeader>
          <CardTitle>Interactive graphing</CardTitle>
          <CardDescription>Zoom, pan, and explore</CardDescription>
        </CardHeader>
        <CardContent className="flex-1">
          <p class="text-sm text-slate-600 dark:text-slate-300">
            A fast canvas graph with adaptive gridlines, smooth zoom-to-cursor, panning, and touch
            support. Plot Cartesian functions, parametric curves, polar equations, and inequalities
            — each expression with its own color and visibility toggle.
          </p>
        </CardContent>
        <CardFooter>
          <a
            href="/graphing-calculator/"
            class="inline-flex items-center gap-1 text-sm font-medium text-brand-600 hover:underline dark:text-brand-400"
          >
            Open the calculator <ArrowRightIcon className="h-4 w-4" />
          </a>
        </CardFooter>
      </Card>

      <Card className="flex flex-col">
        <CardHeader>
          <CardTitle>Real mathematical analysis</CardTitle>
          <CardDescription>Roots, derivatives, integrals</CardDescription>
        </CardHeader>
        <CardContent className="flex-1">
          <p class="text-sm text-slate-600 dark:text-slate-300">
            Find roots with Brent&rsquo;s method, compute derivatives and definite integrals
            numerically, inspect tables of values, and draw tangent lines — all with the same
            engine, honestly reported when a result can&rsquo;t be computed.
          </p>
        </CardContent>
        <CardFooter>
          <a
            href="/calculators/"
            class="inline-flex items-center gap-1 text-sm font-medium text-brand-600 hover:underline dark:text-brand-400"
          >
            Try the math tools <ArrowRightIcon className="h-4 w-4" />
          </a>
        </CardFooter>
      </Card>

      <Card className="flex flex-col">
        <CardHeader>
          <CardTitle>AI math assistant</CardTitle>
          <CardDescription>Ask in plain language</CardDescription>
        </CardHeader>
        <CardContent className="flex-1">
          <p class="text-sm text-slate-600 dark:text-slate-300">
            Ask questions in plain English — the assistant translates them into calculator commands,
            plots what you ask for, and explains step by step. The math engine always does the
            actual computing; the AI never invents results.
          </p>
        </CardContent>
        <CardFooter>
          <a
            href="/graphing-calculator/"
            class="inline-flex items-center gap-1 text-sm font-medium text-brand-600 hover:underline dark:text-brand-400"
          >
            Ask the assistant <ArrowRightIcon className="h-4 w-4" />
          </a>
        </CardFooter>
      </Card>

      <Card className="flex flex-col">
        <CardHeader>
          <CardTitle>Variables, sliders & sharing</CardTitle>
          <CardDescription>Explore and share</CardDescription>
        </CardHeader>
        <CardContent className="flex-1">
          <p class="text-sm text-slate-600 dark:text-slate-300">
            Define variables, animate them with sliders, save named graphs in your browser, and
            share graphs as compact links. Your workspace persists between visits — everything stays
            on your device.
          </p>
        </CardContent>
        <CardFooter>
          <a
            href="/examples/"
            class="inline-flex items-center gap-1 text-sm font-medium text-brand-600 hover:underline dark:text-brand-400"
          >
            See example graphs <ArrowRightIcon className="h-4 w-4" />
          </a>
        </CardFooter>
      </Card>
    </div>
  </section>

  <section aria-label="Explore" class="mt-14">
    <h2 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white">
      Explore the mathematics
    </h2>
    <div class="mt-6 grid gap-4 sm:grid-cols-3">
      <a
        href="/math-functions/"
        class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm transition hover:border-brand-300 hover:shadow dark:border-slate-700 dark:bg-slate-900"
      >
        <h3 class="text-lg font-bold text-slate-900 dark:text-white">Function library</h3>
        <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">
          Sine, quadratics, exponentials and more — each with computed properties.
        </p>
      </a>
      <a
        href="/examples/"
        class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm transition hover:border-brand-300 hover:shadow dark:border-slate-700 dark:bg-slate-900"
      >
        <h3 class="text-lg font-bold text-slate-900 dark:text-white">Example graphs</h3>
        <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">
          Curated graphs that open preloaded in the calculator, with notes.
        </p>
      </a>
      <a
        href="/learn/"
        class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm transition hover:border-brand-300 hover:shadow dark:border-slate-700 dark:bg-slate-900"
      >
        <h3 class="text-lg font-bold text-slate-900 dark:text-white">Learn graphing</h3>
        <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">
          Short guides to functions, derivatives, integrals, and asymptotes.
        </p>
      </a>
    </div>
  </section>
  </div>
</BaseLayout>
